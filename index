<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Traductor de señas</title>
<style>
:root{--bg:#10151c;--panel:#1a222d;--line:#2c3746;--text:#eef2f7;--muted:#93a1b3;--accent:#4cc9a6;--warn:#f0b35a}
*{box-sizing:border-box}
html,body{margin:0;height:100%;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,"Segoe UI",sans-serif}
#app{display:flex;flex-direction:column;height:100%}
#stage{position:relative;flex:1;min-height:0;background:#000;overflow:hidden}
#video,#canvas{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform:scaleX(-1)}
#letra{position:absolute;left:12px;bottom:12px;min-width:84px;padding:4px 18px;border-radius:12px;background:rgba(16,21,28,.78);font-size:64px;font-weight:700;line-height:1.15;text-align:center;color:var(--accent)}
#estado{position:absolute;left:12px;top:12px;right:12px;font-size:14px;color:var(--text);background:rgba(16,21,28,.78);padding:6px 10px;border-radius:8px}
#panel{background:var(--panel);border-top:1px solid var(--line);padding:10px 12px calc(10px + env(safe-area-inset-bottom,0px));display:flex;flex-direction:column;gap:8px}
.fila{display:flex;gap:8px}
input{flex:1;min-width:0;padding:10px;border-radius:8px;border:1px solid var(--line);background:var(--bg);color:var(--text);font-size:16px}
button{padding:10px 14px;border-radius:8px;border:0;background:var(--accent);color:#08231b;font-size:15px;font-weight:600}
button.sec{background:transparent;color:var(--text);border:1px solid var(--line)}
button:focus-visible,input:focus-visible{outline:2px solid var(--warn);outline-offset:2px}
#conteo{font-size:13px;color:var(--muted)}
</style>
</head>
<body>
<div id="app">
  <div id="stage">
    <video id="video" playsinline muted></video>
    <canvas id="canvas"></canvas>
    <div id="estado">Toca "Iniciar cámara"</div>
    <div id="letra">–</div>
  </div>
  <div id="panel">
    <div class="fila">
      <button id="btnCam">Iniciar cámara</button>
      <button id="btnBorrar" class="sec">Borrar muestras</button>
    </div>
    <div class="fila">
      <input id="nombre" placeholder="Letra o palabra a enseñar (ej. A)" maxlength="20" autocapitalize="characters">
      <button id="btnGuardar">Guardar seña</button>
    </div>
    <div id="conteo">Sin muestras guardadas</div>
  </div>
</div>

<script type="module">
import {HandLandmarker, FilesetResolver} from "https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/vision_bundle.mjs";

// Ajustes
const K = 5;                 // vecinos del k-NN
const UMBRAL = 1.2;          // distancia máxima para aceptar una seña (sube si no detecta, baja si confunde)
const FRAMES_ESTABLES = 10;  // cuadros seguidos con la misma seña antes de enviarla
const FRAMES_SIN_MANO = 15;  // cuadros sin mano para permitir repetir la misma letra
const MUESTRAS_POR_CAPTURA = 30;
const CLAVE = "senas_muestras_v1";

const $ = id => document.getElementById(id);
const video = $("video"), canvas = $("canvas"), ctx = canvas.getContext("2d");
let landmarker = null, ultimoTiempo = -1;
let muestras = [];
let capturando = 0, etiquetaCaptura = "";
let candidata = null, cuenta = 0, ultimaEnviada = null, sinMano = 0, contadorEnvios = 0;

// Guardado local (con try/catch por si el WebView no lo permite)
try { muestras = JSON.parse(localStorage.getItem(CLAVE) || "[]"); } catch (e) { muestras = []; }
function guardar() { try { localStorage.setItem(CLAVE, JSON.stringify(muestras)); } catch (e) {} }
function actualizarConteo() {
  const c = {};
  muestras.forEach(m => c[m.l] = (c[m.l] || 0) + 1);
  const txt = Object.entries(c).map(([l, n]) => `${l}: ${n}`).join("   ");
  $("conteo").textContent = txt || "Sin muestras guardadas";
}
actualizarConteo();

// Envío a App Inventor (el contador evita que se ignore una letra repetida)
function enviar(letra) {
  contadorEnvios++;
  const dato = letra + "#" + contadorEnvios;
  try { window.AppInventor.setWebViewString(dato); } catch (e) {}
}

// Vector normalizado: relativo a la muñeca y escalado por el tamaño de la palma
function vector(lm, etiquetaMano) {
  const w = lm[0];
  const s = Math.hypot(lm[9].x - w.x, lm[9].y - w.y) || 1;
  const flip = etiquetaMano === "Left" ? -1 : 1; // así una sola base sirve para ambas manos
  const v = [];
  for (const p of lm) v.push(flip * (p.x - w.x) / s, (p.y - w.y) / s, (p.z - w.z) / s);
  return v;
}
function distancia(a, b) {
  let t = 0;
  for (let i = 0; i < a.length; i++) { const d = a[i] - b[i]; t += d * d; }
  return Math.sqrt(t);
}
function clasificar(v) {
  if (!muestras.length) return null;
  const vecinos = muestras.map(m => ({l: m.l, d: distancia(v, m.v)})).sort((a, b) => a.d - b.d).slice(0, K);
  const votos = {};
  vecinos.forEach(n => votos[n.l] = (votos[n.l] || 0) + 1);
  const mejor = Object.keys(votos).sort((a, b) => votos[b] - votos[a])[0];
  const propios = vecinos.filter(n => n.l === mejor);
  const media = propios.reduce((s, n) => s + n.d, 0) / propios.length;
  return media <= UMBRAL ? mejor : null;
}

function dibujar(lm) {
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  if (!lm) return;
  ctx.lineWidth = 3;
  ctx.strokeStyle = "#4cc9a6";
  for (const c of HandLandmarker.HAND_CONNECTIONS) {
    ctx.beginPath();
    ctx.moveTo(lm[c.start].x * canvas.width, lm[c.start].y * canvas.height);
    ctx.lineTo(lm[c.end].x * canvas.width, lm[c.end].y * canvas.height);
    ctx.stroke();
  }
  ctx.fillStyle = "#f0b35a";
  for (const p of lm) {
    ctx.beginPath();
    ctx.arc(p.x * canvas.width, p.y * canvas.height, 4, 0, 7);
    ctx.fill();
  }
}

function bucle() {
  if (video.readyState >= 2 && video.currentTime !== ultimoTiempo) {
    ultimoTiempo = video.currentTime;
    const r = landmarker.detectForVideo(video, performance.now());
    const lm = r.landmarks && r.landmarks[0];
    dibujar(lm);

    if (lm) {
      sinMano = 0;
      const etiqueta = r.handedness && r.handedness[0] && r.handedness[0][0].categoryName;
      const v = vector(lm, etiqueta);

      if (capturando > 0) {
        muestras.push({l: etiquetaCaptura, v: v.map(x => Math.round(x * 1000) / 1000)});
        capturando--;
        $("estado").textContent = `Guardando "${etiquetaCaptura}"… faltan ${capturando}`;
        if (capturando === 0) { guardar(); actualizarConteo(); $("estado").textContent = "Seña guardada"; }
      } else {
        const letra = clasificar(v);
        $("letra").textContent = letra || "?";
        if (letra && letra === candidata) cuenta++; else { candidata = letra; cuenta = letra ? 1 : 0; }
        if (letra && cuenta >= FRAMES_ESTABLES && letra !== ultimaEnviada) {
          ultimaEnviada = letra;
          enviar(letra);
        }
        if (muestras.length) $("estado").textContent = "Detectando…";
        else $("estado").textContent = "Escribe una letra y toca Guardar seña con la mano a cuadro";
      }
    } else {
      sinMano++;
      candidata = null; cuenta = 0;
      $("letra").textContent = "–";
      if (sinMano >= FRAMES_SIN_MANO) ultimaEnviada = null;
      if (capturando === 0) $("estado").textContent = "Muestra una mano a la cámara";
    }
  }
  requestAnimationFrame(bucle);
}

async function iniciar() {
  $("btnCam").disabled = true;
  try {
    $("estado").textContent = "Cargando modelo…";
    const fileset = await FilesetResolver.forVisionTasks("https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/wasm");
    landmarker = await HandLandmarker.createFromOptions(fileset, {
      baseOptions: {
        modelAssetPath: "https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task",
        delegate: "GPU"
      },
      runningMode: "VIDEO",
      numHands: 1
    });
    const stream = await navigator.mediaDevices.getUserMedia({video: {facingMode: "user", width: 640, height: 480}, audio: false});
    video.srcObject = stream;
    await video.play();
    canvas.width = video.videoWidth;
    canvas.height = video.videoHeight;
    $("btnCam").textContent = "Cámara activa";
    bucle();
  } catch (e) {
    $("estado").textContent = "Error: " + (e.message || e) + ". Revisa el permiso de cámara y que la página use HTTPS.";
    $("btnCam").disabled = false;
  }
}

$("btnCam").addEventListener("click", iniciar);
$("btnGuardar").addEventListener("click", () => {
  const nombre = $("nombre").value.trim().toUpperCase();
  if (!landmarker) { $("estado").textContent = "Primero inicia la cámara"; return; }
  if (!nombre) { $("estado").textContent = "Escribe el nombre de la seña"; return; }
  etiquetaCaptura = nombre;
  capturando = MUESTRAS_POR_CAPTURA;
});
$("btnBorrar").addEventListener("click", () => {
  if (confirm("¿Borrar todas las señas guardadas?")) {
    muestras = []; guardar(); actualizarConteo();
  }
});
</script>
</body>
</html>
